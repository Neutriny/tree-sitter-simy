{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "simy",
      "camelcase": "Simy",
      "title": "Simy",
      "scope": "source.simy",
      "file-types": [
        "simy"
      ],
      "injection-regex": "^simy$",
      "class-name": "TreeSitterSimy"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Simy grammar for tree-sitter",
    "authors": [
      {
        "name": "Neutriny",
        "email": "neutriny@yeah.net"
      }
    ],
    "links": {
      "repository": "https://github.com/Neutriny/tree-sitter-simy"
    }
  },
  "bindings": {
    "c": true
  }
}
